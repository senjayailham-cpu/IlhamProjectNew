rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: allow bootstrap seeding if system is not yet seeded, otherwise deny by default
    match /{document=**} {
      allow read, write: if !exists(/databases/$(database)/documents/system_config/status);
    }

    // Reuseable global security helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isUnchanged(field) {
      return incoming().get(field, null) == existing().get(field, null);
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == "psToBehuTudgpMsgg5xT3h63H6C3" ||
        request.auth.token.email == "senjayailham@gmail.com" ||
        (request.auth.token.email != null && (
          request.auth.token.email.matches('^(admin|ilhamsenjaya|irwanr)@(.*\\.)?austinbatam\\.xyz$')
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function getUserRole() {
      return !isSignedIn() ? 'viewer' :
        exists(/databases/$(database)/documents/users/$(request.auth.uid))
          ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'viewer') :
        (request.auth.token.email != null && request.auth.token.email.matches('^(admin|ilhamsenjaya|irwanr)@(.*\\.)?austinbatam\\.xyz$')) ? 'admin' :
        (request.auth.token.email != null && request.auth.token.email.matches('^(rizki|hasrad)@(.*\\.)?austinbatam\\.xyz$')) ? 'manager' :
        (request.auth.token.email != null && request.auth.token.email.matches('^(andreas)@(.*\\.)?austinbatam\\.xyz$')) ? 'coordinator' :
        (request.auth.token.email != null && request.auth.token.email.matches('^(facility)@(.*\\.)?austinbatam\\.xyz$')) ? 'facility maintanance' :
        (request.auth.token.email != null && request.auth.token.email.matches('^(qc)@(.*\\.)?austinbatam\\.xyz$')) ? 'quality control' :
        (request.auth.token.email != null && request.auth.token.email.matches('^(safety_user)@(.*\\.)?austinbatam\\.xyz$')) ? 'safety' :
        (request.auth.token.email != null && request.auth.token.email.matches('^(pc)@(.*\\.)?austinbatam\\.xyz$')) ? 'project control' :
        'viewer';
    }

    function hasRole(allowedRoles) {
      return isSignedIn() && (getUserRole() in allowedRoles);
    }

    function hasPermission(perm) {
      return isSignedIn() && (
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('allowedPermissions', {}).get(perm, null) != null
            ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.allowedPermissions[perm] == true
            : (
              (perm == 'addProject' && (getUserRole() == 'admin' || getUserRole() == 'manager')) ||
              (perm == 'editProject' && (getUserRole() == 'admin' || getUserRole() == 'manager')) ||
              (perm == 'deleteProject' && (getUserRole() == 'admin')) ||
              (perm == 'addAssembly' && (getUserRole() == 'admin' || getUserRole() == 'manager')) ||
              (perm == 'deleteAssembly' && (getUserRole() == 'admin' || getUserRole() == 'manager')) ||
              (perm == 'addTask' && (getUserRole() == 'admin' || getUserRole() == 'manager' || getUserRole() == 'coordinator' || getUserRole() == 'project control')) ||
              (perm == 'deleteTask' && (getUserRole() == 'admin' || getUserRole() == 'manager' || getUserRole() == 'coordinator')) ||
              (perm == 'updateTask' && (getUserRole() == 'admin' || getUserRole() == 'manager' || getUserRole() == 'coordinator' || getUserRole() == 'facility maintanance' || getUserRole() == 'quality control' || getUserRole() == 'safety' || getUserRole() == 'project control')) ||
              (perm == 'addDifficulty' && (getUserRole() == 'admin' || getUserRole() == 'manager' || getUserRole() == 'coordinator' || getUserRole() == 'project control')) ||
              (perm == 'addTaskInline' && (getUserRole() == 'admin' || getUserRole() == 'manager' || getUserRole() == 'coordinator' || getUserRole() == 'project control')) ||
              (perm == 'manageUsers' && (getUserRole() == 'admin')) ||
              (perm == 'exportData' && (getUserRole() == 'admin' || getUserRole() == 'manager')) ||
              (perm == 'importData' && (getUserRole() == 'admin'))
            )
        )
      );
    }

    // Role-based collection matches
    match /projects/{projectId} {
      allow read: if isAdmin() || isSignedIn();
      allow create: if isAdmin() || hasPermission('addProject');
      allow update: if isAdmin() || hasPermission('editProject') || (
        (hasPermission('updateTask')) && 
        (incoming().diff(existing()).affectedKeys().hasOnly(['assemblies', 'notes', 'status', 'completedDate']) || incoming() == existing())
      );
      allow delete: if isAdmin() || hasPermission('deleteProject');
    }

    match /employees/{employeeId} {
      allow read: if isAdmin() || isSignedIn();
      allow create: if isAdmin() || hasRole(['manager', 'coordinator', 'project control']);
      allow update: if isAdmin() || hasRole(['manager', 'coordinator', 'project control']) || (isSignedIn() && incoming() == existing());
      allow delete: if isAdmin() || hasRole(['manager']);
    }

    match /timesheets/{timesheetId} {
      allow read: if isAdmin() || isSignedIn();
      allow create, update: if isAdmin() || hasRole(['manager', 'coordinator', 'project control']) || (isSignedIn() && incoming() == existing());
      allow delete: if isAdmin() || hasRole(['manager', 'coordinator', 'project control']);
    }

    match /activities/{activityId} {
      allow read: if isAdmin() || isSignedIn();
      allow create: if isAdmin() || isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && incoming() == existing());
    }

    match /users/{userId} {
      // Secure user profiles: only signed-in users can fetch individual docs, preventing unauthenticated hash leakage.
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isAdmin() || (
        isSignedIn() && (
          // Allow creating their own UID mapping document
          userId == request.auth.uid ||
          // Allow creating their own master profile
          userId == incoming().id ||
          // Allow creating if email matches the user id
          (request.auth.token.email != null && request.auth.token.email.startsWith(userId + '@'))
        )
      );
      allow update: if isAdmin() || (
        isSignedIn() && (
          (incoming() == existing()) ||
          // Allow updating if it's their own document
          userId == request.auth.uid ||
          userId == incoming().id ||
          userId == existing().id ||
          (request.auth.token.email != null && request.auth.token.email.startsWith(userId + '@')) ||
          // Or they have a UID mapping linking to this document
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.id == userId)
        )
      );
      allow delete: if isAdmin();
    }

    match /problemReports/{reportId} {
      allow read: if isAdmin() || isSignedIn();
      allow create, update: if isAdmin() || isSignedIn();
      allow delete: if isAdmin() || hasRole(['manager']);
    }

    match /inspections/{inspectionId} {
      allow read: if isAdmin() || isSignedIn();
      allow create: if isAdmin() || hasRole(['manager', 'coordinator', 'project control']);
      allow update: if isAdmin() || hasRole(['manager', 'coordinator', 'project control', 'quality control']) || (isSignedIn() && incoming() == existing());
      allow delete: if isAdmin();
    }

    match /wireLogs/{wireLogId} {
      allow read: if isAdmin() || isSignedIn();
      allow create, update: if isAdmin() || hasRole(['manager', 'coordinator', 'project control', 'facility maintanance', 'quality control', 'safety']) || (isSignedIn() && incoming() == existing());
      allow delete: if isAdmin() || hasRole(['manager', 'coordinator']);
    }

    match /materials/{materialId} {
      allow read: if isAdmin() || isSignedIn();
      allow create, update: if isAdmin() || hasRole(['manager', 'coordinator', 'project control', 'facility maintanance', 'quality control', 'safety']) || (isSignedIn() && incoming() == existing());
      allow delete: if isAdmin() || hasRole(['manager', 'coordinator']);
    }

    match /materialRequests/{requestId} {
      allow read: if isAdmin() || isSignedIn();
      allow create, update: if isAdmin() || hasRole(['manager', 'coordinator', 'project control', 'facility maintanance', 'quality control', 'safety']) || (isSignedIn() && incoming() == existing());
      allow delete: if isAdmin() || hasRole(['manager', 'coordinator']);
    }

    match /consumptionLogs/{logId} {
      allow read: if isAdmin() || isSignedIn();
      allow create, update: if isAdmin() || hasRole(['manager', 'coordinator', 'project control', 'facility maintanance', 'quality control', 'safety']) || (isSignedIn() && incoming() == existing());
      allow delete: if isAdmin() || hasRole(['manager', 'coordinator']);
    }

    match /masterData/{entryId} {
      allow read: if isAdmin() || isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin() || hasRole(['manager']);
    }

    match /system_config/{configId} {
      allow read, write: if isAdmin() || isSignedIn();
    }
  }
}
