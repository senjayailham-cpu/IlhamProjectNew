{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "A project tracking sheet containing Assemblies and Tasks.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "client": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "pending", "completed", "on-hold"] },
        "start": { "type": "string" },
        "due": { "type": "string" },
        "category": { "type": "string", "enum": ["tray", "nontray"] },
        "location": { "type": "string", "enum": ["workshop1", "workshop2"] },
        "created": { "type": "string" },
        "notes": { "type": "string" },
        "budgetHours": { "type": "number" },
        "completedDate": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Employee": {
      "title": "Employee",
      "description": "An employee list entry.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "position": { "type": "string" },
        "location": { "type": "string" },
        "coordinator": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "TimesheetEntry": {
      "title": "TimesheetEntry",
      "description": "A daily labor timesheet record.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "empId": { "type": "string" },
        "empName": { "type": "string" },
        "workOrder": { "type": "string" },
        "description": { "type": "string" },
        "hours": { "type": "number" },
        "approved": { "type": "boolean" },
        "approvedBy": { "type": "string" }
      },
      "required": ["id", "date", "empId", "workOrder", "hours"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "An event log item.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ts": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userRole": { "type": "string" },
        "type": { "type": "string" },
        "action": { "type": "string" }
      },
      "required": ["id", "ts", "action"]
    },
    "ProblemReport": {
      "title": "ProblemReport",
      "description": "A field issue or defect report.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "projectId": { "type": "string" },
        "projectName": { "type": "string" },
        "assemblyId": { "type": "string" },
        "assemblyName": { "type": "string" },
        "taskId": { "type": "string" },
        "taskName": { "type": "string" },
        "reportedBy": { "type": "string" },
        "reportedByName": { "type": "string" },
        "reportedDate": { "type": "string" },
        "description": { "type": "string" },
        "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "status": { "type": "string", "enum": ["open", "resolved", "investigating"] },
        "resolution": { "type": "string" },
        "resolvedBy": { "type": "string" },
        "resolvedDate": { "type": "string" }
      },
      "required": ["id", "title", "projectId", "severity", "status"]
    },
    "InspectionRequest": {
      "title": "InspectionRequest",
      "description": "An inspection sign-off request.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "projectName": { "type": "string" },
        "assemblyId": { "type": "string" },
        "assemblyName": { "type": "string" },
        "title": { "type": "string" },
        "requestedBy": { "type": "string" },
        "requestedByName": { "type": "string" },
        "requestedDate": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "passed", "failed"] },
        "notes": { "type": "string" },
        "qcInspector": { "type": "string" },
        "qcInspectorName": { "type": "string" },
        "inspectedDate": { "type": "string" }
      },
      "required": ["id", "projectId", "title", "status"]
    },
    "WireLog": {
      "title": "WireLog",
      "description": "Daily Wire Consumable record tracking wire taken by welders.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "welderId": { "type": "string" },
        "welderName": { "type": "string" },
        "projectId": { "type": "string" },
        "projectName": { "type": "string" },
        "assemblyId": { "type": "string" },
        "assemblyName": { "type": "string" },
        "amountKg": { "type": "number" },
        "notes": { "type": "string" }
      },
      "required": ["id", "date", "welderId", "projectId", "assemblyId", "amountKg"]
    },
    "MaterialItem": {
      "title": "MaterialItem",
      "description": "Material inventory stock items.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string", "enum": ["Welding Consumable", "Raw Material", "PPE", "Tools & Equipment", "Paint & Chemical", "Other"] },
        "unit": { "type": "string", "enum": ["kg", "pcs", "roll", "liter", "meter", "box", "set"] },
        "currentStock": { "type": "number" },
        "minStock": { "type": "number" },
        "location": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "category", "unit", "currentStock", "minStock"]
    },
    "MaterialRequest": {
      "title": "MaterialRequest",
      "description": "Material request documents (MRs).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "mrNo": { "type": "string" },
        "projectId": { "type": "string" },
        "projectName": { "type": "string" },
        "assemblyId": { "type": "string" },
        "assemblyName": { "type": "string" },
        "urgency": { "type": "string", "enum": ["Normal", "Urgent", "Critical"] },
        "status": { "type": "string", "enum": ["Draft", "Submitted", "Approved", "Issued", "Rejected"] },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "materialId": { "type": "string" },
              "materialName": { "type": "string" },
              "unit": { "type": "string" },
              "qtyRequested": { "type": "number" },
              "qtyIssued": { "type": "number" }
            },
            "required": ["materialId", "materialName", "unit", "qtyRequested"]
          }
        },
        "requestedBy": { "type": "string" },
        "requestedById": { "type": "string" },
        "requestedDate": { "type": "string" },
        "notes": { "type": "string" },
        "approvedBy": { "type": "string" },
        "approvedDate": { "type": "string" },
        "rejectedReason": { "type": "string" },
        "issuedBy": { "type": "string" },
        "issuedDate": { "type": "string" }
      },
      "required": ["id", "mrNo", "projectId", "projectName", "urgency", "status", "items", "requestedBy", "requestedById", "requestedDate"]
    },
    "MaterialConsumptionLog": {
      "title": "MaterialConsumptionLog",
      "description": "Logs tracking material consumption in the workshop.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "materialId": { "type": "string" },
        "materialName": { "type": "string" },
        "unit": { "type": "string" },
        "qtyUsed": { "type": "number" },
        "projectId": { "type": "string" },
        "projectName": { "type": "string" },
        "assemblyId": { "type": "string" },
        "assemblyName": { "type": "string" },
        "issuedBy": { "type": "string" },
        "mrId": { "type": "string" },
        "mrNo": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "date", "materialId", "materialName", "unit", "qtyUsed", "projectId", "projectName", "issuedBy"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Stores active and archived projects with their nested structures."
    },
    "/employees/{employeeId}": {
      "schema": "Employee",
      "description": "List of active workshop employees."
    },
    "/timesheets/{timesheetId}": {
      "schema": "TimesheetEntry",
      "description": "Labor hours registry."
    },
    "/activities/{activityId}": {
      "schema": "ActivityLog",
      "description": "System event activity logs."
    },
    "/problemReports/{reportId}": {
      "schema": "ProblemReport",
      "description": "Critical issues and QC reports."
    },
    "/inspections/{inspectionId}": {
      "schema": "InspectionRequest",
      "description": "QA/QC structural inspection sign-offs."
    },
    "/wireLogs/{wireLogId}": {
      "schema": "WireLog",
      "description": "Daily wire consumable registry for welding personnel."
    },
    "/materials/{materialId}": {
      "schema": "MaterialItem",
      "description": "Store available material items in warehouse."
    },
    "/materialRequests/{requestId}": {
      "schema": "MaterialRequest",
      "description": "Material request sheets."
    },
    "/consumptionLogs/{logId}": {
      "schema": "MaterialConsumptionLog",
      "description": "Daily or job-based material consumption logs."
    }
  }
}
