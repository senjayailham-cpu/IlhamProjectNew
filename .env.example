# Gemini API Key (Server-side)
GEMINI_API_KEY=

# Firebase Configuration
# Get these values from Firebase Console → Project Settings
VITE_FIREBASE_API_KEY="your-api-key-here"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_ID="your-messaging-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
VITE_FIREBASE_DATABASE_ID="your-firestore-database-id"

# Default seed passwords — CHANGE before deploying
VITE_DEFAULT_ADMIN_PASS="change-me-strong-password"
VITE_DEFAULT_MANAGER_PASS="change-me-strong-password"
VITE_DEFAULT_STAFF_PASS="change-me-strong-password"
