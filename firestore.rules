rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == "psToBehuTudgpMsgg5xT3h63H6C3" ||
        request.auth.token.email == "senjayailham@gmail.com" ||
        (request.auth.token.email != null && (
          request.auth.token.email.matches('^(admin|ilhamsenjaya|irwanr)@(.*\\.)?austinbatam\\.xyz$')
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isOwner(userId) {
      return isSignedIn() && (
        request.auth.uid == userId ||
        (request.auth.token.email != null && (
          request.auth.token.email == userId + "@austinbatam.xyz" ||
          request.auth.token.email.matches('^' + userId + '@(.*\\.)?austinbatam\\.xyz$')
        ))
      );
    }

    // Restrict all collections strictly to signed-in users, ensuring admin always has complete access
    match /projects/{projectId} {
      allow read, write: if isAdmin() || isSignedIn();
    }
    match /employees/{employeeId} {
      allow read, write: if isAdmin() || isSignedIn();
    }
    match /timesheets/{timesheetId} {
      allow read, write: if isAdmin() || isSignedIn();
    }
    match /activities/{activityId} {
      allow read, write: if isAdmin() || isSignedIn();
    }
    match /users/{userId} {
      // Allow unauthenticated get requests to enable login profile check before background Auth sign-in
      allow get: if true;
      allow list, write: if isAdmin() || isSignedIn();
    }
    match /problemReports/{reportId} {
      allow read, write: if isAdmin() || isSignedIn();
    }
    match /inspections/{inspectionId} {
      allow read, write: if isAdmin() || isSignedIn();
    }
    match /wireLogs/{wireLogId} {
      allow read, write: if isAdmin() || isSignedIn();
    }

    match /system_config/{configId} {
      allow read, write: if isAdmin() || isSignedIn();
    }
  }
}
