rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Reuseable global security helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isUnchanged(field) {
      return incoming().get(field, null) == existing().get(field, null);
    }

    function getUserIdByAuth() {
      return (request.auth.token.email != null && (
        request.auth.token.email.endsWith('@austinbatam.xyz') || 
        request.auth.token.email.matches('.*\\.austinbatam\\.xyz$')
      )) 
        ? request.auth.token.email.split('@')[0]
        : request.auth.uid;
    }

    function isUserOwner(userId) {
      return isSignedIn() && (
        request.auth.uid == userId ||
        (request.auth.token.email != null && request.auth.token.email.split('@')[0] == userId)
      );
    }

    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(getUserIdByAuth())) && 
        get(/databases/$(database)/documents/users/$(getUserIdByAuth())).data.role == 'admin';
    }

    function getUserRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(getUserIdByAuth()))
        ? get(/databases/$(database)/documents/users/$(getUserIdByAuth())).data.role
        : 'viewer';
    }

    function hasRole(allowedRoles) {
      return isSignedIn() && (getUserRole() in allowedRoles);
    }

    // Role-based collection matches
    match /projects/{projectId} {
      allow read: if isAdmin() || isSignedIn();
      allow create: if isAdmin() || hasRole(['manager']);
      allow update: if isAdmin() || hasRole(['manager']) || (
        (hasRole(['coordinator', 'facility maintanance', 'quality control', 'safety', 'project control'])) && 
        (incoming().diff(existing()).affectedKeys().hasOnly(['assemblies', 'notes', 'status', 'completedDate']) || incoming() == existing())
      );
      allow delete: if isAdmin();
    }

    match /employees/{employeeId} {
      allow read: if isAdmin() || isSignedIn();
      allow create: if isAdmin() || hasRole(['manager', 'coordinator', 'project control']);
      allow update: if isAdmin() || hasRole(['manager', 'coordinator', 'project control']) || (isSignedIn() && incoming() == existing());
      allow delete: if isAdmin() || hasRole(['manager']);
    }

    match /timesheets/{timesheetId} {
      allow read: if isAdmin() || isSignedIn();
      allow create, update: if isAdmin() || hasRole(['manager', 'coordinator', 'project control']) || (isSignedIn() && incoming() == existing());
      allow delete: if isAdmin() || hasRole(['manager', 'coordinator', 'project control']);
    }

    match /activities/{activityId} {
      allow read: if isAdmin() || isSignedIn();
      allow create: if isAdmin() || isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && incoming() == existing());
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (isAdmin() || isUserOwner(userId) || 
                  (exists(/databases/$(database)/documents/users/$(getUserIdByAuth())) && 
                   get(/databases/$(database)/documents/users/$(getUserIdByAuth())).data.role in ['admin', 'manager']));
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() && isUserOwner(userId) &&
        isUnchanged('role') && isUnchanged('allowedFeatures') && isUnchanged('allowedPermissions') &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'password', 'passHash'])
      );
      allow delete: if isAdmin();
    }

    match /problemReports/{reportId} {
      allow read: if isAdmin() || isSignedIn();
      allow create, update: if isAdmin() || isSignedIn();
      allow delete: if isAdmin() || hasRole(['manager']);
    }

    match /inspections/{inspectionId} {
      allow read: if isAdmin() || isSignedIn();
      allow create: if isAdmin() || hasRole(['manager', 'coordinator', 'project control']);
      allow update: if isAdmin() || hasRole(['manager', 'coordinator', 'project control', 'quality control']) || (isSignedIn() && incoming() == existing());
      allow delete: if isAdmin();
    }

    match /wireLogs/{wireLogId} {
      allow read: if isAdmin() || isSignedIn();
      allow create, update: if isAdmin() || hasRole(['manager', 'coordinator', 'project control', 'facility maintanance', 'quality control', 'safety']) || (isSignedIn() && incoming() == existing());
      allow delete: if isAdmin() || hasRole(['manager', 'coordinator']);
    }

    match /system_config/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
